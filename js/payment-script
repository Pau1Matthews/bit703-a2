  const form = document.getElementById('payment-form');
  const paymentBoxes = document.querySelectorAll('.payment-box');
  
  

    paymentBoxes.forEach(box => {
        const checkbox = box.querySelector('input[type="radio"]');
        
        box.addEventListener('click', () => {
            updatePaymentHighlight();
            toggleRequiredFields();
        });
    });

    function updatePaymentHighlight() {
        paymentBoxes.forEach(box => {
            const checkbox = box.querySelector('input[type="radio"]');
            if (checkbox.checked) {
                box.classList.add('label-active');
            } else {
                box.classList.remove('label-active');
            }
        });
    }

  function toggleRequiredFields() {
    const selectedMethod = document.querySelector('input[name="payment-method"]:checked').value;
    const creditCardInputs = document.querySelectorAll(
    '#card-number, #card-expiry-date, #card-cw, #card-holder-name');

    if (selectedMethod === 'paypal') {
      creditCardInputs.forEach(input => {
        input.removeAttribute('required');
      });
    } else {
      creditCardInputs.forEach(input => {
        input.setAttribute('required', 'required');
      });
    }
  }

 // Submit Logic 
    form.addEventListener('submit', (e) => {
        e.preventDefault();

        console.log('Form Submitted successfully:');
        alert('Order Placed, Have a Nice Day');
        window.location.href = "index.html";
    });

})